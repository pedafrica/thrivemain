{
  "name": "image-optimizer",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "clean": "rimraf ./build",
    "test": "tap \"test/**/*.test.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node build/server.js",
    "start:pm2": "pm2 start build/server.js --watch",
    "dev": "ts-node-dev --clear --transpile-only --respawn -r tsconfig-paths/register src/server.ts -host",
    "devClient": "ts-node-dev --clear --respawn src/test-client/index.client.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/auth": "^4.2.0",
    "@fastify/autoload": "^5.0.0",
    "@fastify/caching": "^8.3.0",
    "@fastify/cors": "^8.2.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^7.6.0",
    "@fastify/sensible": "^4.1.0",
    "@fastify/swagger": "^8.3.1",
    "@fastify/swagger-ui": "^1.5.0",
    "@fastify/type-provider-typebox": "^2.4.0",
    "@sinclair/typebox": "^0.25.24",
    "axios": "^1.3.5",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.36.4",
    "deep-equal": "^2.2.0",
    "dotenv": "^16.0.3",
    "fastify": "^4.15.0",
    "fastify-cli": "^4.4.0",
    "fastify-disablecache": "^3.1.1",
    "fastify-mailer": "^2.3.1",
    "fastify-multer": "^2.0.3",
    "fastify-plugin": "^3.0.0",
    "moment": "^2.29.4",
    "mongoose": "^7.0.2",
    "mysql2": "^3.2.0",
    "nodemailer": "^6.9.1",
    "pluralize": "^8.0.0",
    "prettier": "^2.8.8",
    "pump": "^3.0.0",
    "sequelize": "^6.31.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^18.12.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/deep-equal": "^1.0.1",
    "@types/node": "^18.16.9",
    "@types/nodemailer": "^6.4.7",
    "@types/paystack": "^2.0.1",
    "@types/pluralize": "^0.0.29",
    "@types/pump": "^1.1.1",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^10.0.0",
    "rimraf": "^4.4.1",
    "tap": "^16.3.4",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.4"
  }
}
